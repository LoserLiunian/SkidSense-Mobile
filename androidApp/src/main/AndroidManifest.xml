<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is needed for both carriers: the relay WebSocket to the backend,
      and the LAN WebSocket straight to the desktop.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning the pairing QR code on the desktop's screen. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
            android:allowBackup="false"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network_security_config"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:usesCleartextTraffic="true"
            android:theme="@style/Theme.SkidSense">
        <!--
          singleTask is a tradeoff, kept knowingly: it is what makes a tapped
          pairing link reach `onNewIntent` instead of a second MainActivity.
          Its cost is the launcher's clear-top — a scanner or document picker
          sitting on top is torn down when the user re-enters via the icon —
          and any app able to fire a view intent can pull the UI to the
          pairing screen. That screen always asks before pairing, and a link
          whose data was already consumed once cannot replay (S32/S34).
        -->
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:launchMode="singleTask"
                android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
                android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              The pairing link the desktop shows: `skidsense://pair/1?d=…`.
              Tapping it opens the app rather than a browser.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="skidsense" />
            </intent-filter>
        </activity>
    </application>

</manifest>
